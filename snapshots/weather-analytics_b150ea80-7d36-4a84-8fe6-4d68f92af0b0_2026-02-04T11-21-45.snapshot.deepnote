        - blockGroup: 8e8cf192c7bb4d379fc20f6f5525d7f9
          content: |-
            ## 4. Save Prepared Data

            Export the data for use in further analysis notebooks.
          id: 33f78e203160f66c40653b5639d6600f
          metadata: {}
          sortingKey: a11
          type: markdown
          contentHash: sha256:7708f35b4df6a489540da428fb20fc278266910d659f570ba9d1880fb05b49a4
        - blockGroup: 7c49067bbdcf43c993549adeeddb9901
          content: |-
            # Save to CSV for later use
            weather_data.to_csv('weather_data_2024.csv', index=False)
            print(f"Data saved to weather_data_2024.csv")
            print(f"Total size: {len(weather_data)} records")

            # Display summary statistics by city
            summary = weather_data.groupby('city').agg({
                'temperature': ['mean', 'min', 'max'],
                'humidity': 'mean',
                'precipitation': 'sum'
            }).round(1)

            print("\nSummary by City:")
            summary
          id: 3e82e3ff070c2c771b69dc4bae311094
