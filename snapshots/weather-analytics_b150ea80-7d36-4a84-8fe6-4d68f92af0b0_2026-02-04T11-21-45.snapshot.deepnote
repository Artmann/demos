        - blockGroup: 4dc16a43b36343d392e30b7a0ed21bbb
          content: |-
            ## 1. Generate Weather Data

            We'll create synthetic weather data for multiple cities to demonstrate our analysis pipeline.
          id: 47ad7fdf2625c5aefd8e3d9a964ffd66
          metadata: {}
          sortingKey: a2
          type: markdown
          contentHash: sha256:ebae85c2ed15b1b8c3294f0dfe248e40b25e49f78adcc62bbe712940319026a1
        - blockGroup: a00b661329444d03a44a5d33fdbb8c06
          content: |-
            # Define cities and their base temperatures
            cities = {
                'New York': {'base_temp': 12, 'variation': 15},
                'Los Angeles': {'base_temp': 18, 'variation': 8},
                'Chicago': {'base_temp': 10, 'variation': 18},
                'Miami': {'base_temp': 25, 'variation': 5},
                'Seattle': {'base_temp': 11, 'variation': 10}
            }

            # Generate date range
            start_date = datetime(2024, 1, 1)
            end_date = datetime(2024, 12, 31)
            date_range = pd.date_range(start=start_date, end=end_date, freq='D')
          id: 7cae62f802aa13d4e86ecf56590e1f61
          metadata:
            execution_start: 1757059656636
            execution_millis: 1
            execution_context_id: 40ed428b-d24e-4c73-85f1-c4c2a48af0bd
          sortingKey: a3
          type: code
          contentHash: sha256:f3345c708dbd0539f5b2c59d76a6e5e87abd0d1ff9ec491cf4742d1218bef3f4
          executionCount: 2
        - blockGroup: 32125a84808147eb91827d47528d006f
          content: |-
            def generate_weather_data(city_name, city_info, dates):
                """Generate realistic weather data for a city"""
                n_days = len(dates)
                
                # Generate temperature with seasonal variation
                day_of_year = np.array([d.timetuple().tm_yday for d in dates])
                seasonal_effect = city_info['variation'] * np.sin(2 * np.pi * day_of_year / 365)
                random_variation = np.random.normal(0, 3, n_days)
                
                temperature = city_info['base_temp'] + seasonal_effect + random_variation
                
                # Generate correlated humidity (inversely related to temperature)
                humidity = 70 - (temperature - city_info['base_temp']) * 2 + np.random.normal(0, 5, n_days)
                humidity = np.clip(humidity, 20, 95)
                
                # Generate precipitation (more likely when humidity is high)
                precipitation_prob = (humidity - 50) / 100
                precipitation = np.where(
                    np.random.random(n_days) < precipitation_prob,
                    np.random.exponential(5, n_days),
                    0
                )
                
                return pd.DataFrame({
                    'date': dates,
                    'city': city_name,
                    'temperature': temperature.round(1),
                    'humidity': humidity.round(0),
                    'precipitation': precipitation.round(1)
                })
          id: d4afb837d302857a2911ca548f83f1d2
          metadata:
            execution_start: 1757059656687
            execution_millis: 0
            execution_context_id: 40ed428b-d24e-4c73-85f1-c4c2a48af0bd
          sortingKey: a4
          type: code
          contentHash: sha256:30dfd5c718903765b18bcb97185478951c1e0419a2bcc798408a0ba8681f954e
          executionCount: 3
        - blockGroup: f834aa9755c0468698a7f6852be5ced1
          content: |-
            # Generate data for all cities
            weather_data = pd.concat([
                generate_weather_data(city, info, date_range)
                for city, info in cities.items()
            ], ignore_index=True)

            print(f"Generated {len(weather_data)} records for {len(cities)} cities")
            print(f"Date range: {weather_data['date'].min()} to {weather_data['date'].max()}")
            weather_data.head(10)
