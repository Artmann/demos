        - blockGroup: 144863929db74235b1d437f3e3b30712
          content: |-
            # Create seasonal temperature comparison chart
            fig, axes = plt.subplots(2, 2, figsize=(14, 10))
            seasons = ['Winter', 'Spring', 'Summer', 'Fall']

            for idx, season in enumerate(seasons):
                ax = axes[idx // 2, idx % 2]
                season_data = weather_data[weather_data['season'] == season]
                
                # Box plot for temperature distribution
                season_data.boxplot(column='temperature', by='city', ax=ax)
                ax.set_title(f'{season} Temperature Distribution', fontsize=12, fontweight='bold')
                ax.set_xlabel('City')
                ax.set_ylabel('Temperature (°C)')
                ax.set_ylim(-10, 40)
                plt.sca(ax)
                plt.xticks(rotation=45)

            plt.suptitle('Temperature Distribution by Season and City', fontsize=14, fontweight='bold', y=1.02)
            plt.tight_layout()
            plt.show()
          id: d4dee8d6e5484845bebb8ec3d1de0459
          metadata:
