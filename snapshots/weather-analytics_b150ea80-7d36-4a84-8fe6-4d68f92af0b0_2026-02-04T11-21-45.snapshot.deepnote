          content: |-
            # Calculate seasonal statistics
            seasonal_stats = weather_data.groupby(['city', 'season']).agg({
                'temperature': ['mean', 'std'],
                'humidity': 'mean',
                'precipitation': ['sum', 'mean']
            }).round(2)

            seasonal_stats
          id: d3ddc2d5bf0045a0b66b90a0c6dadfb4
