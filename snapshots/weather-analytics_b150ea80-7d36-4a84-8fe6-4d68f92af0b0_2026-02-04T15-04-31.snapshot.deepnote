        - blockGroup: 96c36d9c6ad94f7da11b8bf638ff68a5
          content: |-
            ## 3. Initial Visualization

            Let's create a quick visualization to verify our data looks reasonable.
          id: 1f137c1219d46be0b974aeac0e380a2c
          metadata: {}
          sortingKey: a9
          type: markdown
          contentHash: sha256:3b6474906758cf3620e492cffcaf68c05d008d7d7ba0e848618baad7420c4d11
        - blockGroup: 9851b2dbfa3745f59b0f4c23a7d338c6
          content: |-
            # Plot temperature trends for all cities
            fig, ax = plt.subplots(figsize=(14, 6))

            for city in cities.keys():
                city_data = weather_data[weather_data['city'] == city]
                # Plot 30-day rolling average for smoother lines
                rolling_temp = city_data.set_index('date')['temperature'].rolling(window=30, center=True).mean()
                ax.plot(rolling_temp.index, rolling_temp.values, label=city, linewidth=2)

            ax.set_xlabel('Date', fontsize=12)
            ax.set_ylabel('Temperature (°C)', fontsize=12)
            ax.set_title('Temperature Trends Across Cities (30-day Moving Average)', fontsize=14, fontweight='bold')
            ax.legend(loc='best')
            ax.grid(True, alpha=0.3)

            plt.tight_layout()
            plt.show()
          id: ef37da3713c0b9dc135947d2346bf779
          metadata:
            execution_start: 1757059656857
            execution_millis: 380
            execution_context_id: 40ed428b-d24e-4c73-85f1-c4c2a48af0bd
