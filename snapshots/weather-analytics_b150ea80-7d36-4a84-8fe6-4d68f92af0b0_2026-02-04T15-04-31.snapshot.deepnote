            weather_data.to_csv('weather_data_2024.csv', index=False)
            print(f"Data saved to weather_data_2024.csv")
            print(f"Total size: {len(weather_data)} records")

            # Display summary statistics by city
            summary = weather_data.groupby('city').agg({
                'temperature': ['mean', 'min', 'max'],
                'humidity': 'mean',
                'precipitation': 'sum'
            }).round(1)

            print("\nSummary by City:")
            summary
          id: 3e82e3ff070c2c771b69dc4bae311094
