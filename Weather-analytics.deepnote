        - blockGroup: 972b106245d1448195cadafc23e040c4
          content: |-
            # Load the data
            weather_data = pd.read_csv('weather_data_2024.csv')
            weather_data['date'] = pd.to_datetime(weather_data['date'])

            # Add temporal features
            weather_data['month'] = weather_data['date'].dt.month
            weather_data['season'] = weather_data['month'].map({
                12: 'Winter', 1: 'Winter', 2: 'Winter',
                3: 'Spring', 4: 'Spring', 5: 'Spring',
                6: 'Summer', 7: 'Summer', 8: 'Summer',
                9: 'Fall', 10: 'Fall', 11: 'Fall'
            })

            print(f"Loaded {len(weather_data)} records")
            print(f"Cities: {weather_data['city'].unique()}")
            weather_data.head()
