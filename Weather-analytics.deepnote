        - blockGroup: 2a7089315dfb4ce4aa475d92ca118088
          content: |-
            ## 3. Correlation Analysis

            Examine relationships between temperature, humidity, and precipitation.
          id: da652b923cad4fa3bde872147d9d9c66
          metadata: {}
          sortingKey: yj
          type: markdown
          contentHash: sha256:fa43a4d23e8ce0c18b0aa006fc329bfd7d59afe24302f17bd01baa45c21b07f4
        - blockGroup: fbca6533dc8a45628b578686fb57d323
          content: |-
            # Calculate correlations for each city
            correlations = {}
            for city in weather_data['city'].unique():
                city_data = weather_data[weather_data['city'] == city]
                correlations[city] = city_data[['temperature', 'humidity', 'precipitation']].corr()

            # Create correlation heatmap
            fig, axes = plt.subplots(2, 3, figsize=(15, 10))
            axes = axes.flatten()

            for idx, (city, corr_matrix) in enumerate(correlations.items()):
                sns.heatmap(corr_matrix, annot=True, cmap='coolwarm', center=0,
                            vmin=-1, vmax=1, ax=axes[idx], cbar_kws={'shrink': 0.8})
                axes[idx].set_title(f'{city}', fontsize=11, fontweight='bold')

            # Hide the last subplot if we have fewer cities than subplots
            if len(correlations) < 6:
                axes[-1].axis('off')

            plt.suptitle('Weather Variable Correlations by City', fontsize=14, fontweight='bold')
            plt.tight_layout()
            plt.show()
          id: 78d48246dce94f38adc8e45f66aaf4ce
          metadata:
            execution_start: 1759392815070
