          content: |-
            ## 5. Monthly Precipitation Patterns

            Analyze and visualize precipitation patterns throughout the year.
          id: 0faa3e9023f4491c86ea931ff66f8d34
          metadata: {}
          sortingKey: yy
          type: markdown
          contentHash: sha256:81b747c26011cc9f35b4333f60a3a509c6e7fe3aaf6cca7ef00288c3f1597afc
        - blockGroup: c4f95608ee004b7da2cd31a552b66704
          content: |-
            # Calculate monthly precipitation totals
            monthly_precip = weather_data.groupby(['city', 'month'])['precipitation'].sum().reset_index()
            monthly_precip_pivot = monthly_precip.pivot(index='month', columns='city', values='precipitation')

            # Create stacked area chart for precipitation
            fig, ax = plt.subplots(figsize=(14, 7))

            # Plot each city's precipitation as a line
            for city in monthly_precip_pivot.columns:
                ax.plot(monthly_precip_pivot.index, monthly_precip_pivot[city], 
                       marker='o', linewidth=2.5, label=city, markersize=8)

            ax.set_xlabel('Month', fontsize=12)
            ax.set_ylabel('Total Precipitation (mm)', fontsize=12)
            ax.set_title('Monthly Precipitation Patterns by City', fontsize=14, fontweight='bold')
            ax.set_xticks(range(1, 13))
            ax.set_xticklabels(['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 
                                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'])
            ax.legend(loc='best')
            ax.grid(True, alpha=0.3)

            plt.tight_layout()
            plt.show()
          id: d922f8c1cb754315bf2f396b1b0b4c03
          metadata:
            execution_start: 1759392817021
