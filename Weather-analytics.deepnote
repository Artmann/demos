        - blockGroup: 0036113c43a94e63892e61e311f4dc68
          content: |-
            ## 4. Extreme Weather Events

            Identify and analyze extreme weather events (unusually high/low temperatures, heavy precipitation).
          id: 669a008341a14c6e9029b5fe7b6da288
          metadata: {}
          sortingKey: yv
          type: markdown
          contentHash: sha256:2b1605abdd10419f86cec025da95fd96c6484a614f0215fb31e3b673011cfcec
        - blockGroup: fc181e90dd544d7dbf9cccf5250ef596
          content: |-
            # Define extreme weather thresholds
            extreme_events = []

            for city in weather_data['city'].unique():
                city_data = weather_data[weather_data['city'] == city]
                
                # Calculate thresholds (mean ± 2 standard deviations)
                temp_mean = city_data['temperature'].mean()
                temp_std = city_data['temperature'].std()
                precip_95 = city_data['precipitation'].quantile(0.95)
                
                # Find extreme events
                hot_days = len(city_data[city_data['temperature'] > temp_mean + 2*temp_std])
                cold_days = len(city_data[city_data['temperature'] < temp_mean - 2*temp_std])
                heavy_rain_days = len(city_data[city_data['precipitation'] > precip_95])
                
                extreme_events.append({
                    'City': city,
                    'Extremely Hot Days': hot_days,
                    'Extremely Cold Days': cold_days,
                    'Heavy Precipitation Days': heavy_rain_days,
                    'Total Extreme Days': hot_days + cold_days + heavy_rain_days
                })

            extreme_df = pd.DataFrame(extreme_events)
            extreme_df = extreme_df.sort_values('Total Extreme Days', ascending=False)
            print("Extreme Weather Events by City:")
            extreme_df
